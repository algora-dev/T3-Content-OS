# T3 Labs Content OS - Environment Variables
# Copy to .env.local for local development. Never commit .env.local.

# ── Supabase (dedicated Content OS project) ──────────────────────────
# Public URL and anon key - safe for browser
NEXT_PUBLIC_SUPABASE_URL=https://your-content-os-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_key

# Service role key - SERVER ONLY, never expose to browser or agents
# Used for admin bootstrap and system-level operations
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# ── App ──────────────────────────────────────────────────────────────
# Base URL of the Content OS app (for callbacks, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Agent API ────────────────────────────────────────────────────────
# Secret used to sign agent API tokens (server-side only)
AGENT_TOKEN_SECRET=replace_with_a_long_random_secret

# ── Security ─────────────────────────────────────────────────────────
# Used for CSRF token generation
CSRF_SECRET=replace_with_another_long_random_secret
